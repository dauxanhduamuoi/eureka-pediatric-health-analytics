+describe('Admin document scroll ownership (JSDOM lifecycle, not layout measurements)', () => {
+  function installStyles() {
+    const style = document.createElement('style');
+    // Exercise the real rules without resolving CSS imports in JSDOM.
+    style.textContent = adminStyles.replace(/^@import[^;]*;/gm, '');
+    document.head.appendChild(style);
+    const rule = style.sheet!.cssRules[0] as CSSStyleRule;
+    expect(rule.style.overflow).toBe('hidden');
+    // Check the real rule/DOM lifecycle here; Chrome verifies viewport geometry,
+    // wheel events and actual scroll reachability separately.
+    return { remove: () => style.remove(), locks: () => [document.documentElement, document.body].map(element => element.matches(rule.selectorText) && getComputedStyle(element).overflow === 'hidden') };
+  }
+
+  it('locks only while the authenticated workspace exists and resets an incoming document offset', () => {
+    const scrollTo = vi.spyOn(window, 'scrollTo').mockImplementation(() => {});
+    const style = installStyles();
+    const scrollY = Object.getOwnPropertyDescriptor(window, 'scrollY')!;
+    const before = style.locks();
+    try {
+      Object.defineProperty(window, 'scrollY', { configurable: true, value: 500 });
+      const view = mount();
+      expect(style.locks()).toEqual([true, true]);
+      expect(scrollTo).toHaveBeenCalledWith({ top: 0, left: 0, behavior: 'instant' });
+      view.unmount();
+      expect(style.locks()).toEqual(before);
+    } finally { Object.defineProperty(window, 'scrollY', scrollY); style.remove(); scrollTo.mockRestore(); }
+  });
+
+  it('does not lock Login/AuthGate or Parent, including after repeated Admin mounts', () => {
+    const scrollTo = vi.spyOn(window, 'scrollTo').mockImplementation(() => {});
