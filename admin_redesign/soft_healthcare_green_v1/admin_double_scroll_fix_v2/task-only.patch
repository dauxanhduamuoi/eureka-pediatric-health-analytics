+      expect(style.locks()).toEqual([true, true]);
+      for (const className of ['eureka-admin admin-auth', 'parent-portal']) {
+        view.rerender(<div className={className}>Public content</div>);
+        expect(style.locks()).toEqual([false, false]);
+        const admin = mount();
+        expect(style.locks()).toEqual([true, true]);
+        admin.unmount();
+        expect(style.locks()).toEqual([false, false]);
+      }
+    } finally { style.remove(); scrollTo.mockRestore(); }
+  });
+
+  it('moves skip-link focus into main without scrolling the document', () => {
