+    --admin-muted: #276749;
+    --admin-scroll-track: var(--admin-surface);
+    --admin-scroll-thumb: #65b981;
+  }
+  :root .eureka-admin[data-sidebar='collapsed'] .admin-navigation:hover { --admin-scroll-thumb: #449b62; }
