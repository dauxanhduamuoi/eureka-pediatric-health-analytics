 :root .eureka-admin [hidden] { display: none !important; }
 .admin-brand { display: flex; align-items: center; gap: 10px; min-height: 88px; padding: 18px 16px; flex-shrink: 0; }
 .admin-brand-mark { display: grid; place-items: center; width: 36px; height: 38px; flex-shrink: 0; border-radius: 11px; background: var(--admin-mint); color: var(--admin-primary); }
