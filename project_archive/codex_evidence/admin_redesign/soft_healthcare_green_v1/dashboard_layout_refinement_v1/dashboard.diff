 .admin-metric-strip > .admin-kpi::before { display: none; }
 .admin-metric-strip .admin-kpi-icon { background: transparent; padding: 0; }
 .admin-dashboard-charts { gap: var(--content-gap); }
+.eureka-admin .admin-dashboard-content .admin-dashboard-charts { display: grid; grid-template-columns: minmax(0, 1fr); align-items: start; }
+.eureka-admin .admin-dashboard-ranking { display: grid; gap: 12px; list-style: none; margin: 0; padding: 0; }
+.admin-dashboard-ranking > li { display: flex; align-items: baseline; gap: 8px; min-width: 0; border-radius: 4px; }
+.admin-dashboard-rank { flex: 0 0 18px; color: var(--admin-muted); font-size: 11px; font-variant-numeric: tabular-nums; }
+.admin-dashboard-rank-content { flex: 1; min-width: 0; }
+.admin-dashboard-rank-heading { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 3px 12px; font-size: 12px; }
+.admin-dashboard-rank-label { flex: 1 1 150px; min-width: 0; overflow-wrap: anywhere; }
+.admin-dashboard-rank-label strong { font-weight: 600; line-height: 1.5; }
+.admin-dashboard-rank-label small { display: block; color: var(--admin-muted); line-height: 1.5; font-size: 10px; }
+.admin-dashboard-rank-value { color: var(--admin-ink); font-weight: 700; font-variant-numeric: tabular-nums; white-space: nowrap; }
+.admin-dashboard-rank-value small { color: var(--admin-muted); font-size: 10px; font-weight: 400; }
+.admin-dashboard-rank-track { height: 6px; margin-top: 5px; border-radius: 4px; background: var(--admin-subtle); overflow: hidden; }
+.admin-dashboard-rank-track > span { display: block; height: 100%; border-radius: inherit; background: var(--admin-primary); }
+@media (min-width: 1100px) {
+  .eureka-admin .admin-dashboard-content .admin-dashboard-charts { grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); }
+}
 .admin-year-coverage-list { display: grid; gap: 5px; }
 .admin-year-coverage-list > div { display: flex; flex-wrap: wrap; gap: 4px 12px; padding: 4px 0; background: transparent; box-shadow: none; }
 .admin-year-coverage-list > div > div { margin-top: 0; font-size: 12px; }
