@@ -0,0 +1,115 @@
+/* Shared Admin + Login type/control system. Scoped adapters win over legacy
+   utilities and page styles without changing Parent or semantic status colours. */
+.eureka-admin {
+  --admin-font-family: 'Nunito', 'Segoe UI', Arial, sans-serif;
+  --admin-font-title: 24px;
+  --admin-font-section: 16px;
+  --admin-font-body: 14px;
+  --admin-font-label: 13px;
+  --admin-font-meta: 12px;
+  --admin-leading-body: 1.6;
+  --admin-leading-heading: 1.35;
+  --admin-control-height: 40px;
+}
+
+#root .eureka-admin {
+  font-family: var(--admin-font-family);
+  font-size: var(--admin-font-body);
+  font-weight: 400;
+  line-height: var(--admin-leading-body);
+}
+#root .eureka-admin :is(input, select, textarea, button) { font-family: inherit; }
+#root .eureka-admin :is(h1, h2, h3, h4) { line-height: var(--admin-leading-heading); letter-spacing: -.02em; font-weight: 700; }
+#root .eureka-admin .admin-page h2 { font-size: var(--admin-font-section); font-weight: 600; }
+#root .eureka-admin :is(.admin-topbar h1, .admin-heading-copy h2) { font-size: var(--admin-font-title); }
