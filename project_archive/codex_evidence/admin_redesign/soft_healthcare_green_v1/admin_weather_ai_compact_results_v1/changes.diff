+.admin-weather-card-english { color: var(--admin-muted); font-size: var(--admin-font-meta); line-height: 1.5; margin-top: 3px; }
+.admin-weather-card-caption { color: var(--admin-muted); font-size: var(--admin-font-label); line-height: var(--admin-leading-body); margin-top: 5px; }
+.admin-weather-card-toggle { display: inline-flex; align-items: center; justify-content: center; gap: 6px; padding: 8px 12px; border: 1px solid var(--admin-border); border-radius: var(--admin-control-radius); background: var(--admin-mint); color: var(--admin-accent-ink); }
