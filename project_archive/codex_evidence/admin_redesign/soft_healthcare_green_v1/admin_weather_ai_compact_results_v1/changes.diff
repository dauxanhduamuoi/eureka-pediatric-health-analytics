+.admin-weather-card-heading { display: flex; align-items: flex-start; flex-wrap: wrap; gap: 12px; }
+.admin-weather-card-rank { display: grid; place-items: center; flex: 0 0 34px; height: 34px; border-radius: 10px; background: var(--admin-mint); color: var(--admin-accent-ink); font-size: var(--admin-font-body); font-weight: 600; }
